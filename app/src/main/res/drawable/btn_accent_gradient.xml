<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <gradient android:startColor="#fb923c" android:endColor="#c2410c" android:angle="45.0" android:centerColor="#f97316" />
            <stroke android:width="2.5dp" android:color="#ffffff" />
            <corners android:radius="14.0dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <gradient android:startColor="#ea580c" android:endColor="#9a3412" android:angle="45.0" android:centerColor="#c2410c" />
            <stroke android:width="1.5dp" android:color="#fdba74" />
            <corners android:radius="14.0dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:startColor="#f97316" android:endColor="#c2410c" android:angle="45.0" android:centerColor="#ea580c" />
            <corners android:radius="14.0dp" />
        </shape>
    </item>
</selector>
