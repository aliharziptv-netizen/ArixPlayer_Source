<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#3d141e" />
            <stroke android:width="2.5dp" android:color="#f87171" />
            <corners android:radius="22.0dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#4a1925" />
            <stroke android:width="2.0dp" android:color="#ef4444" />
            <corners android:radius="22.0dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#261016" />
            <stroke android:width="1.1999817dp" android:color="#ef4444" />
            <corners android:radius="22.0dp" />
        </shape>
    </item>
</selector>
