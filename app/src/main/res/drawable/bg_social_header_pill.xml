<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#212c4a" />
            <stroke android:width="2.5dp" android:color="#22d3ee" />
            <corners android:radius="18.0dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#212c4a" />
            <stroke android:width="1.5dp" android:color="#22d3ee" />
            <corners android:radius="18.0dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#121a2e" />
            <stroke android:width="1.0dp" android:color="#243356" />
            <corners android:radius="18.0dp" />
        </shape>
    </item>
</selector>
