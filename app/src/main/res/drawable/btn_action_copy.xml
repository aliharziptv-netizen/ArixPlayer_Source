<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#2f3c57" />
            <stroke android:width="2.5dp" android:color="#38bdf8" />
            <corners android:radius="12.0dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#1f283a" />
            <stroke android:width="1.5dp" android:color="#22d3ee" />
            <corners android:radius="12.0dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#242e42" />
            <stroke android:width="1.0dp" android:color="#3b4863" />
            <corners android:radius="12.0dp" />
        </shape>
    </item>
</selector>
