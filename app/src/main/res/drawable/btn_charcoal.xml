<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#1f2e4d" />
            <stroke android:width="2.1999817dp" android:color="#22d3ee" />
            <corners android:radius="12.0dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#141c2e" />
            <stroke android:width="1.0dp" android:color="#f97316" />
            <corners android:radius="12.0dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#182238" />
            <stroke android:width="1.0dp" android:color="#27385a" />
            <corners android:radius="12.0dp" />
        </shape>
    </item>
</selector>
