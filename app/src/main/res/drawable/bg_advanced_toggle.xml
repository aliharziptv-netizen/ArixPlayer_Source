<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#362419" />
            <stroke android:width="2.1999817dp" android:color="#fb923c" />
            <corners android:radius="12.0dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#2f2119" />
            <stroke android:width="1.5dp" android:color="#f97316" />
            <corners android:radius="12.0dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#141414" />
            <stroke android:width="1.0dp" android:color="#282828" />
            <corners android:radius="12.0dp" />
        </shape>
    </item>
</selector>
