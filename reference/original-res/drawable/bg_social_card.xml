<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#1a2542" />
            <stroke android:width="2.5dp" android:color="#22d3ee" />
            <corners android:radius="16.0dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#162035" />
            <stroke android:width="1.5dp" android:color="#f97316" />
            <corners android:radius="16.0dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#101728" />
            <stroke android:width="1.0dp" android:color="#1b2640" />
            <corners android:radius="16.0dp" />
        </shape>
    </item>
</selector>
