<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#103820" />
            <stroke android:width="2.5dp" android:color="#34d399" />
            <corners android:radius="22.0dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#15472a" />
            <stroke android:width="2.0dp" android:color="#10b981" />
            <corners android:radius="22.0dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#0c2014" />
            <stroke android:width="1.1999817dp" android:color="#10b981" />
            <corners android:radius="22.0dp" />
        </shape>
    </item>
</selector>
