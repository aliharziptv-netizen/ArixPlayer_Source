<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#482d1c" />
            <stroke android:width="2.5dp" android:color="#fdba74" />
            <corners android:radius="22.0dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#573723" />
            <stroke android:width="2.0dp" android:color="#f97316" />
            <corners android:radius="22.0dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#311f13" />
            <stroke android:width="1.1999817dp" android:color="#f97316" />
            <corners android:radius="22.0dp" />
        </shape>
    </item>
</selector>
