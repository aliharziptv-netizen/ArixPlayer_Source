<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#213052" />
            <stroke android:width="2.5dp" android:color="#22d3ee" />
            <corners android:radius="20.0dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#213052" />
            <stroke android:width="1.5dp" android:color="#f97316" />
            <corners android:radius="20.0dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#172238" />
            <stroke android:width="1.0dp" android:color="#253556" />
            <corners android:radius="20.0dp" />
        </shape>
    </item>
</selector>
