<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#1c2845" />
            <stroke android:width="2.1999817dp" android:color="#22d3ee" />
            <corners android:radius="14.0dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#18233c" />
            <stroke android:width="1.5dp" android:color="#f97316" />
            <corners android:radius="14.0dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/card_sub_surface" />
            <stroke android:width="1.0dp" android:color="#212e4a" />
            <corners android:radius="14.0dp" />
        </shape>
    </item>
</selector>
