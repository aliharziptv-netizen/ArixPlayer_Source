<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#8c4e26" />
            <stroke android:width="2.0dp" android:color="#fdba74" />
            <corners android:radius="10.0dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#724224" />
            <stroke android:width="1.0dp" android:color="#fb923c" />
            <corners android:radius="10.0dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#452a1a" />
            <stroke android:width="1.0dp" android:color="#c2410c" />
            <corners android:radius="10.0dp" />
        </shape>
    </item>
</selector>
