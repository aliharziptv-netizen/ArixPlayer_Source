<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#1e2942" />
            <stroke android:width="2.5dp" android:color="#22d3ee" />
            <corners android:radius="18.0dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#22304f" />
            <stroke android:width="2.0dp" android:color="#f97316" />
            <corners android:radius="18.0dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/card_surface" />
            <stroke android:width="1.1999817dp" android:color="@color/border_subtle" />
            <corners android:radius="18.0dp" />
        </shape>
    </item>
</selector>
