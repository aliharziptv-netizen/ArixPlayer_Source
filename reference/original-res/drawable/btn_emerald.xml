<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <gradient android:startColor="#059669" android:endColor="#10b981" android:angle="45.0" />
            <stroke android:width="2.5dp" android:color="#ffffff" />
            <corners android:radius="14.0dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <gradient android:startColor="#047857" android:endColor="#059669" android:angle="45.0" />
            <corners android:radius="14.0dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:startColor="#10b981" android:endColor="#059669" android:angle="45.0" />
            <corners android:radius="14.0dp" />
        </shape>
    </item>
</selector>
