<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#1a2e3d" />
            <stroke android:width="2.5dp" android:color="#10b981" />
            <corners android:radius="14.0dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#1a2640" />
            <stroke android:width="1.5dp" android:color="#10b981" />
            <corners android:radius="14.0dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#121b2f" />
            <stroke android:width="1.0dp" android:color="#1e2b45" />
            <corners android:radius="14.0dp" />
        </shape>
    </item>
</selector>
